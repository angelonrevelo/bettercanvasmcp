# Your Canvas personal access token. Never commit a real token.
CANVAS_API_TOKEN=

# Your school's Canvas host. Required. No school is hardcoded.
CANVAS_BASE_URL=https://canvas.example.edu

# Optional default course. Pass course_id per call if this is empty.
CANVAS_COURSE_ID=

CANVAS_REQUEST_TIMEOUT_MS=30000
CANVAS_REQUEST_RETRY_COUNT=2

# Local snapshot directory for the engagement binary. Defaults to ~/.cache/canvas-engagement.
CANVAS_STATE_DIR=
