{
  "name": "better-canvas-mcp",
  "version": "0.4.0",
  "description": "Read-only Canvas LMS MCP for students. Reports the edges popular Canvas MCPs skip: due-date overrides, New Quizzes, group work, and file text.",
  "type": "module",
  "bin": {
    "better-canvas-mcp": "./dist/index.js",
    "better-canvas-engagement": "./dist/engagement.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-surface.mjs",
    "gate": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelonrevelo/bettercanvasmcp.git"
  },
  "author": "angelonrevelo",
  "license": "MIT",
  "keywords": [
    "mcp",
    "canvas-lms",
    "canvas",
    "model-context-protocol",
    "instructure"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
